# Copy to .env before `docker compose up --build`. Never commit the filled-in copy.
#
# The three variables without defaults are required; compose fails fast with a named error if
# any is missing, which is far easier to diagnose than a container that starts and then can't
# authenticate.

# --- PostgreSQL -------------------------------------------------------------------------
POSTGRES_USER=finance
POSTGRES_DB=finance_analysis
# Required. Any strong value; it never leaves the compose network.
POSTGRES_PASSWORD=change-me-postgres-password

# --- Authentication ---------------------------------------------------------------------
# Required. At least 32 bytes of entropy — this signs every access token.
#   openssl rand -base64 48
#   pwsh: [Convert]::ToBase64String((1..48 | % { Get-Random -Max 256 }))
JWT_SIGNING_KEY=change-me-to-at-least-32-bytes-of-random-data

# Set to false once your users exist, to close public signups.
ALLOW_REGISTRATION=true

# --- Internal endpoints -----------------------------------------------------------------
# Required. Sent as the X-Internal-Api-Key header by scripts/daily-ingest.*.
#   openssl rand -hex 32
INTERNAL_API_KEY=change-me-internal-api-key

# --- Market data ------------------------------------------------------------------------
# "mock" generates deterministic synthetic bars and needs no key, so the stack is fully
# functional out of the box. Switch to "polygon" and set the key for real data.
MARKET_DATA_PROVIDER=mock
POLYGON_API_KEY=

# --- Ports ------------------------------------------------------------------------------
# Where the SPA (and its /api proxy) is published.
WEB_PORT=8080
# Loopback-only port for the cron job to reach /api/internal/*.
API_LOOPBACK_PORT=5080
